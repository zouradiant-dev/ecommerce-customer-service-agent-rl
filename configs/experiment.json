{
  "seed": 7,
  "task_replicas": 3,
  "model": "Qwen/Qwen2.5-7B-Instruct",
  "base_model": {
    "id": "Qwen/Qwen2.5-7B-Instruct",
    "family": "Qwen2.5",
    "parameter_scale": "7B",
    "training_method": "QLoRA"
  },
  "baseline_trials_per_task": 4,
  "grpo_trials_per_task": 6,
  "max_agent_steps": 20,
  "temperature": 0.8,
  "reward": {
    "mode": "strict_binary",
    "process_reward_enabled": false
  },
  "evaluation": {
    "paired_by_task": true,
    "pass_k": [1, 2, 4],
    "bootstrap_samples": 10000
  }
}
